# Copy this file to .env on homeserv01 and fill in the real values.
# DO NOT commit .env — it contains secrets.

# Encryption key for n8n credentials at rest. Generate a strong one:
#   openssl rand -hex 32
# CRITICAL: back this up separately from n8n_data. If lost, existing
# stored credentials in n8n become unreadable.
N8N_ENCRYPTION_KEY=

# Basic auth on the n8n UI (defense in depth on top of Tailscale ACLs).
# Password should be strong even though Tailscale gates access.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Your Tailscale MagicDNS hostname for this machine. Find it with:
#   tailscale status | head -2
# Format: <machine-name>.<tailnet-name>.ts.net
# Example: homeserv01.tail-abc123.ts.net
N8N_HOSTNAME=
